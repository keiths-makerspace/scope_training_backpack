	(text "J1 - mates with FRDM J1" (exclude_from_sim no) (at 36.2 27.94 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "e1cb2f2b-e6f4-5279-9513-712c829b855d"))
	(text "1: P3_16 = DDS_D0\n2: P4_3 DAC1_OUT = DAC1\n3: P4_13 (LCD_D5 on J13)\n4: P4_2 DAC0_OUT = DAC0\n5: P3_20 = DDS_D4\n6: P0_29 = TOUCH_Y-\n7: P1_21 ENET_MDIO\n8: P1_23 = DDS_W_CLK" (exclude_from_sim no) (at 116.2 31.75 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "ad4a8f04-d9f3-565f-981d-494a78ae79fe"))
	(text "9: P3_18 = DDS_D2\n10: P0_30 = DDS_D6\n11: P3_17 = DDS_D1\n12: P1_21 ENET_MDIO\n13: P3_19 = DDS_D3\n14: P1_2 LED_BLUE\n15: P3_21 = DDS_D5\n16: P0_31 = DDS_D7" (exclude_from_sim no) (at 161.2 31.75 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "3b8be964-9fd8-580b-b4eb-75c90cef222b"))
	(text "J2 - mates with FRDM J2" (exclude_from_sim no) (at 36.2 71.12 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "90499c15-221e-5c93-aa0b-90b86e0021f5"))
	(text "1: ADC1_B0\n2: P0_28 = MUX_SEL\n3: P5_2\n4: P0_10 LED_RED\n5: P5_3\n6: P0_27 FC1_P3 (LED_GREEN) = SPI_CS\n7: P5_4\n8: P0_24 FC1_P0 = SPI_MOSI\n9: P0_3 TDI\n10: P0_26 FC1_P2 = SPI_MISO" (exclude_from_sim no) (at 116.2 74.93 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "3e861bef-78d7-5f92-912b-ef5228cf70ac"))
	(text "11: P1_12 CAN1_RXD = CAN_RX\n12: P0_25 FC1_P1 = SPI_CLK\n13: P0_19 = DDS_FQ_UD\n14: GND = GND\n15: P1_1 FC3_P1 = UART_TX\n16: AREF / VDD_ANA\n17: P1_0 FC3_P0 = UART_RX\n18: P4_0 FC2_P0 = I2C_SDA\n19: not connected on FRDM\n20: P4_1 FC2_P1 = I2C_SCL" (exclude_from_sim no) (at 161.2 74.93 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "966beb94-7259-51c6-92d0-617c953e70c2"))
	(text "J3 - mates with FRDM J3" (exclude_from_sim no) (at 36.2 119.38 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "14be7c6e-f90d-5beb-a5ac-a8c1911baa89"))
	(text "1: P2_0\n2: ADC0_A3\n3: P1_22\n4: IOREF (P3V3)\n5: P2_3 = DDS_RESET\n6: RESET_B\n7: P2_2 PWM1_A2 = PWM2\n8: P3V3 (700 mA LDO) = +3.3V" (exclude_from_sim no) (at 116.2 123.19 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "c71ae3cf-36a8-589d-9f02-2a538bdc7601"))
	(text "9: P2_5 PWM1_B1 = LCD_BL\n10: P5V0\n11: P2_4 PWM1_A1 = PWM1\n12: GND = GND\n13: P2_7 PWM1_B0 = PWM3\n14: GND = GND\n15: P2_6 PWM1_A0 = PWM0\n16: VIN" (exclude_from_sim no) (at 161.2 123.19 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "92868fb8-a459-5c11-907e-e3f34e049caf"))
	(text "J4 - mates with FRDM J4" (exclude_from_sim no) (at 36.2 160.02 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "3ab72ff7-9261-5ce0-bd14-3d7b26c8febe"))
	(text "1: P4_12 (LCD_D4 on J13)\n2: ADC0_A0 = ADC_IN\n3: OPAMP0_INN\n4: ADC0_B0\n5: P4_16 CAN1_TXD = CAN_TX\n6: P0_14 ADC0_B14 = TOUCH_X+" (exclude_from_sim no) (at 116.2 163.83 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "7bb94132-edcf-5381-8ab6-843ad2221a00"))
	(text "7: OPAMP1_INN\n8: P0_22 ADC0_A14 = TOUCH_Y+\n9: P4_20\n10: P0_15 = TOUCH_X-\n11: OPAMP2_INN\n12: P0_23 WAKEUP_B" (exclude_from_sim no) (at 161.2 163.83 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "f3ef2ba5-0ce4-5879-a915-98ff9c146d43"))
	(text "J13 - mates with FRDM J8 (FlexIO LCD)" (exclude_from_sim no) (at 36.2 198.12 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "0ce050ac-3cb5-51bd-9a11-e3a506ad8689"))
	(text "1: P3V3\n2: GND = GND\n3: P4_1 (I2C on J2)\n4: P4_0 (I2C on J2)\n5: P4_6\n6: P4_5 = DDS_AUX\n7: P4_7 = LCD_RST\n8: P0_7 = LCD_RS\n9: P0_12 = LCD_CS\n10: P0_9 FLEXIO0_D1 = LCD_WR\n11: P0_8\n12: P0_13\n13: P2_8 FLEXIO0_D16 = LCD_D0\n14: P2_9 FLEXIO0_D17 = LCD_D1" (exclude_from_sim no) (at 116.2 201.93 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "78005bc6-f249-5367-b782-edbb114ee466"))
	(text "15: P2_10 FLEXIO0_D18 = LCD_D2\n16: P2_11 FLEXIO0_D19 = LCD_D3\n17: P4_12 FLEXIO0_D20 = LCD_D4\n18: P4_13 FLEXIO0_D21 = LCD_D5\n19: P4_14 FLEXIO0_D22 = LCD_D6\n20: P4_15 FLEXIO0_D23 = LCD_D7\n21: P4_16 (CAN on J4)\n22: P4_17 USB OC\n23: P4_18\n24: P4_19\n25: P4_20\n26: P4_21\n27: P4_22\n28: P4_23" (exclude_from_sim no) (at 161.2 201.93 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "b3735023-4c0b-52fd-b597-54e38f69f4ea"))
