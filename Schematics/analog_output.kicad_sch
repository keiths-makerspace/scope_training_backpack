	(text "DAC0 -> SMA1  (0-3.3 V, DC-500 kHz)" (exclude_from_sim no) (at 22.86 30.48 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "af747683-22f6-575d-8f7d-41ca187546cf"))
	(text "DAC1 -> SMA2  (0-3.3 V with R7 fitted; about 0-300 mV with R5/R6 fitted and R7 removed)" (exclude_from_sim no) (at 22.86 81.28 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "59e0c666-c4e1-56d7-9774-663e574e2c4a"))
	(text "PWM0 -> 1.6 kHz low-pass -> SMA3" (exclude_from_sim no) (at 22.86 132.08 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "f27cf6f4-4ded-5611-b0eb-bf8d67344eca"))
	(text "PWM1 -> runt network -> SMA4  (buffer slew limit turns narrow pulses into runts)" (exclude_from_sim no) (at 187.96 30.48 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "41b2737a-3e85-5e0c-bca3-61ee4662ba6d"))
	(text "PWM2 -> SMA5  fit exactly ONE of R15 (small signal), R17 (glitch), R18 (direct, default)" (exclude_from_sim no) (at 187.96 66.04 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "b00ec736-4a77-5ca0-bbfd-58445bb46188"))
	(text "ADC input header J10 -> protection, 1.6 MHz anti-alias, buffer -> ADC_IN" (exclude_from_sim no) (at 187.96 134.62 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "b99c9eb7-3bd7-5311-8139-b3661b0762d7"))
	(text "AD9851 module -> J12 -> gain of 2 -> SMA8  (1 Vpp into 50R, 2 Vpp into high-Z, 10 Hz-20 MHz)" (exclude_from_sim no) (at 220.98 184.15 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "7f07a297-652c-5b06-8c50-127ab8ebe9c3"))
	(text "Amp output sits at 2.5 V DC. C32 blocks it; R65 bleeds C32 so\nthe SMA settles near 0 V. At 10 Hz: about -0.8 dB into high-Z,\n-3 dB into 50R. Limit firmware to 10 Hz-20 MHz." (exclude_from_sim no) (at 328.93 238.76 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "64fd3e25-3e7c-5af6-94fc-cbb6f95f7a59"))
	(text "Op-amp supplies and spare section" (exclude_from_sim no) (at 22.86 205.74 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left top)) (uuid "8ba73451-5402-5ec6-9d3f-53a8c826a8bd"))
	(text "U3A unused: follower with +IN tied low" (exclude_from_sim no) (at 35.56 240.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "70754ddf-433b-5b6f-afa9-4069f5d9cabd"))
	(text "C1/C2: AC coupling is only active with R1/R3 removed; the buffer input then needs a DC bias path (not provided).\nSMA shells return to GNDA. Keep analog traces away from digital clocks." (exclude_from_sim no) (at 22.86 254 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6bb3f006-5789-5238-8769-4e00c84b4984"))
